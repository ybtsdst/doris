{
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable",
    "sonarlint.pathToCompileCommands": "/opt/transwarp/doris/be/build_Debug/compile_commands.json",
    "sonarlint.testFilePattern": "{/opt/transwarp/doris/thirdparty/installed/include/**, /usr/include/**}",
    "cmake.generator": "Unix Makefiles",
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "on",
        "strings": "on"
    },
    "spellright.language": [],
    "spellright.documentTypes": [
        "latex"
    ],
    // the intellisense response is slow due to todo extension, and we remove it in devcontainer.
    // but we also find the clangd performs well on code intellisense and clangd also brings some other benefit, e.g. checking header files: remove unnecessary header
    // so we disable ms cpptools extension and switch to clangd; 
    // maybe we switch back later for other reasons
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.intelliSenseCacheSize": 0,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.links": false
    },
    // "clangd.path": "/usr/local/lib/clangd/bin/clangd",
    "clangd.path": "clangd",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--log=verbose",
        "--pch-storage=memory",
        "--query-driver=/var/local/ldb-toolchain/bin/clang",
        "--suggest-missing-includes",
        "--cross-file-rename",
        "--completion-style=detailed",
        "-j=80",
        "--all-scopes-completion",
        "--malloc-trim"
    ],
    "terminal.integrated.profiles.linux": {
        "bash (login)": {
            "path": "/bin/bash",
            "args": [
                "-l"
            ]
        }
    },
    "terminal.integrated.defaultProfile.linux": "bash (login)",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.browse.databaseFilename": "${workspaceFolder}/.vscode/.browse.c_cpp.db",
    "protobuf.clangFormat.enabled": true,
    "protobuf.clangFormat.path": "clang-format",
    "protobuf.protoc.path": "/opt/transwarp/doris/thirdparty/installed/bin/protoc"
}
